# Simulation General
SEED=42
TOTAL_EPISODES=50
STEPS_PER_EPISODE=100
SLOT_DURATION=0.1
SLOTS_PER_FRAME=10

# Workload Parameters
ARRIVAL_RATE=30
ZIPF_PARAM=0.8

# Upper Agent (Service Placement) Hyperparameters
UPPER_LR=1e-4
UPPER_BATCH_SIZE=32
UPPER_GAMMA=0.99
UPPER_TAU=0.005
UPPER_BUFFER_CAPACITY=10000
UPPER_TEMP=1.0

# Lower Agent (Offloading) Hyperparameters
LOWER_LR=1e-4
LOWER_BATCH_SIZE=32
LOWER_GAMMA=0.99
LOWER_TAU=0.005
LOWER_BUFFER_CAPACITY=10000
LOWER_TEMP=1.0

# Network Parameters
DEFAULT_BANDWIDTH=600
PROPAGATION_DELAY=0.005
TRANSMISSION_POWER=0.2

# Paths
TOPOLOGY_XML=configs/topologies/atlanta.xml
TOPOLOGY_JSON=configs/topologies/atlanta_processed.json
LOGS_DIR=data/logs/
CHECKPOINT_DIR=data/models/
